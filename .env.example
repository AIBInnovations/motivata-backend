# =============================================================================
# MOTIVATA BACKEND — ENVIRONMENT VARIABLES
# Copy this file to .env and fill in all values before starting the server.
# Never commit .env to git.
# =============================================================================


# -----------------------------------------------------------------------------
# SERVER
# -----------------------------------------------------------------------------
PORT=5000
NODE_ENV=production
TZ=Asia/Kolkata


# -----------------------------------------------------------------------------
# DATABASE (MongoDB Atlas)
# Two connection strings kept here — comment out the one you don't need.
# MONGODB_URL        → production Atlas cluster
# MONGODB_URL_DEV    → development Atlas cluster (or local)
# The app reads MONGODB_URL. Switch by editing/commenting the active line.
# -----------------------------------------------------------------------------
MONGODB_URL=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGODB_URL_DEV=mongodb+srv://<user>:<password>@<dev-cluster>.mongodb.net/<dbname-dev>?retryWrites=true&w=majority


# -----------------------------------------------------------------------------
# JWT
# Use long, random strings (32+ chars). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# -----------------------------------------------------------------------------
JWT_SECRET=replace_with_random_secret
JWT_ACCESS_SECRET=replace_with_random_access_secret
JWT_REFRESH_SECRET=replace_with_random_refresh_secret


# -----------------------------------------------------------------------------
# CORS
# Comma-separated list of allowed frontend origins (no trailing slash)
# -----------------------------------------------------------------------------
ALLOWED_ORIGINS=https://motivata.in,https://motivata.synquic.com,https://admin.motivata.synquic.com


# -----------------------------------------------------------------------------
# CLOUDINARY (image / file uploads)
# Get from: https://console.cloudinary.com → Settings → API Keys
# -----------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret


# -----------------------------------------------------------------------------
# FIREBASE CLIENT SDK (used in app for push notifications / analytics)
# Get from: Firebase Console → Project Settings → Your apps → Web app config
# -----------------------------------------------------------------------------
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_API_KEY=your-firebase-api-key
FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
FIREBASE_MESSAGING_SENDER_ID=000000000000
FIREBASE_APP_ID=1:000000000000:web:xxxxxxxxxxxxxxxx
FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# FIREBASE ADMIN SDK (server-side push notifications via FCM)
# Get from: Firebase Console → Project Settings → Service Accounts → Generate new private key
# Paste the JSON values from the downloaded key file below.
FIREBASE_ADMIN_TYPE=service_account
FIREBASE_ADMIN_PROJECT_ID=your-project-id
FIREBASE_ADMIN_PRIVATE_KEY_ID=key_id_from_json
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"
FIREBASE_ADMIN_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
FIREBASE_ADMIN_CLIENT_ID=000000000000000000000
FIREBASE_ADMIN_AUTH_URI=https://accounts.google.com/o/oauth2/auth
FIREBASE_ADMIN_TOKEN_URI=https://oauth2.googleapis.com/token
FIREBASE_ADMIN_AUTH_PROVIDER_CERT_URL=https://www.googleapis.com/oauth2/v1/certs
FIREBASE_ADMIN_CLIENT_CERT_URL=https://www.googleapis.com/robot/v1/metadata/x509/firebase-adminsdk-xxxxx%40your-project-id.iam.gserviceaccount.com
FIREBASE_ADMIN_UNIVERSE_DOMAIN=googleapis.com


# -----------------------------------------------------------------------------
# PAYMENT — RAZORPAY
# PAYMENT_GATEWAY must be "RAZORPAY" in production (not "MOCK")
# Get keys from: https://dashboard.razorpay.com → Settings → API Keys
# Webhook secret from: Razorpay Dashboard → Settings → Webhooks
# -----------------------------------------------------------------------------
PAYMENT_GATEWAY=RAZORPAY
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret


# -----------------------------------------------------------------------------
# FRONTEND URL (used in payment callback redirects)
# -----------------------------------------------------------------------------
FRONTEND_URL=https://motivata.in


# -----------------------------------------------------------------------------
# EMAIL (Nodemailer — Brevo SMTP recommended for production)
# Brevo SMTP: https://app.brevo.com → Settings → SMTP & API
# -----------------------------------------------------------------------------
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your-brevo-login@smtp-brevo.com
EMAIL_PASSWORD=your-brevo-smtp-password
EMAIL_FROM=noreply@motivata.in
EMAIL_FROM_NAME=Motivata


# -----------------------------------------------------------------------------
# WHATSAPP (WappService API)
# Get from your WappService dashboard
# -----------------------------------------------------------------------------
WHATSAPP_API_KEY=your_whatsapp_api_key
WHATSAPP_VENDOR_UID=your_vendor_uid


# -----------------------------------------------------------------------------
# CALENDLY
# Personal Access Token: https://calendly.com/integrations/api_webhooks
# Webhook signing key: from your Calendly webhook config
# -----------------------------------------------------------------------------
CALENDLY_PAT=your_calendly_personal_access_token
CALENDLY_WEBHOOK_SIGNING_KEY=your_calendly_webhook_signing_key


# -----------------------------------------------------------------------------
# BACKGROUND JOBS
# Set to "true" to enable scheduled jobs (reminders, cleanup, sync).
# Set to "false" on staging/dev to avoid duplicate jobs running alongside prod.
# -----------------------------------------------------------------------------
RUN_BACKGROUND_JOBS=true
